<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{341A8A34-16CB-4033-814A-FA5805CA5A4E}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="RickDialogPro.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="tests\RickDialogPro.Tests.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="sample\RickDialogPro.Sample.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="RickDialogPro">
        <MSBuild Projects="RickDialogPro.dproj"/>
    </Target>
    <Target Name="RickDialogPro:Clean">
        <MSBuild Projects="RickDialogPro.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RickDialogPro:Make">
        <MSBuild Projects="RickDialogPro.dproj" Targets="Make"/>
    </Target>
    <Target Name="RickDialogPro_Tests">
